# =============================================================================
# RGS Demo AWS - Unified Configuration File
# =============================================================================
# This single terraform.tfvars file contains configuration for all modules:
#   - shared-services/
#   - rancher-manager/
#   - eks-cluster/
#   - observability/
#   - security/
#
# Usage: Each module should reference this file via:
#   tofu apply -var-file=../terraform.tfvars
#
# Copy this file to terraform.tfvars (gitignored) in the repo root and fill
# in real values. Do not commit terraform.tfvars.
# =============================================================================

# -----------------------------------------------------------------------------
# Global Configuration
# -----------------------------------------------------------------------------
aws_region  = "us-east-2"
environment = "rgs-demo-aws"
owner       = "your-name"

# -----------------------------------------------------------------------------
# Network Configuration (shared-services module)
# -----------------------------------------------------------------------------
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-2a"]
az_count           = 1
enable_nat_gateway = false

# -----------------------------------------------------------------------------
# Security Configuration (all modules)
# -----------------------------------------------------------------------------
# IMPORTANT: Restrict these to your IP address for better security
allowed_ssh_cidr_blocks = ["0.0.0.0/0"]
allowed_web_cidr_blocks = ["0.0.0.0/0"]
allowed_cidr_blocks     = ["0.0.0.0/0"]

# -----------------------------------------------------------------------------
# SSH Configuration (all product modules)
# -----------------------------------------------------------------------------
# Paste your SSH public key here
ssh_public_key = ""

#  [ ! -f ~/.ssh/rgs-demo-aws.pem ] && { aws ec2 create-key-pair --key-name rgs-demo-aws --region us-east-2 --query "KeyMaterial" --output text > ~/.ssh/rgs-demo-aws.pem; chmod 0600 ~/.ssh/rgs-demo-aws.pem; }
#  ssh-keygen -y -f ~/.ssh/rgs-demo-aws.pem > ~/.ssh/rgs-demo-aws.pub; cat ~/.ssh/rgs-demo-aws.pub
# NOTE: each product module creates its own <environment>-<module>-key key pair from this public key

# -----------------------------------------------------------------------------
# EC2 Instance Configuration (per module)
# -----------------------------------------------------------------------------
rancher_instance_type      = "t3.large"
rancher_root_volume_size   = 100

observability_instance_type    = "m5.4xlarge"  # confirmed minimum for the "10-nonha" sizing profile - non-burstable
observability_root_volume_size = 300           # Elasticsearch/Kafka/HBase/ClickHouse need persistent storage

security_instance_type    = "t3.large"
security_root_volume_size = 100

# -----------------------------------------------------------------------------
# Elastic IP Configuration (all product modules)
# -----------------------------------------------------------------------------
create_eip = true

# -----------------------------------------------------------------------------
# DNS Configuration (Route53 - optional)
# -----------------------------------------------------------------------------
create_route53_record = true
root_domain            = "kubernerdes.com"
subdomain              = "rgs-demo-aws"
route53_zone_id        = ""  # Leave empty to auto-discover
# To find your Route53 zone ID (filtered to the exact zone - the unfiltered
# `HostedZones[].Id` form returns every zone your IAM principal can see, not
# just this one):
# aws route53 list-hosted-zones-by-name \
#   --dns-name rgs-demo-aws.kubernerdes.com \
#   --query "HostedZones[?Name=='rgs-demo-aws.kubernerdes.com.'].Id | [0]" \
#   --output text

# DNS Hostnames (per product)
hostname_rancher       = "rancher"
hostname_observability = "observability"
hostname_userapps      = "user-apps"

# -----------------------------------------------------------------------------
# Let's Encrypt Configuration (all product modules)
# -----------------------------------------------------------------------------
enable_letsencrypt      = true
letsencrypt_email       = "your-email@example.com"
letsencrypt_environment = "production"  # Use "staging" for testing, "production" for real certs

# -----------------------------------------------------------------------------
# RGS / Carbide Portal Registration
# -----------------------------------------------------------------------------
# Credentials issued via the Carbide Portal for the Carbide Secured Registry.
# This demo is fully internet-connected, so nodes authenticate to Carbide
# directly (no Hauler/Harbor mirroring for v1).
rgs_carbide_registry = "registry.ranchercarbide.dev"
rgs_carbide_username = "YOUR-CARBIDE-PORTAL-USERNAME"
rgs_carbide_password = "YOUR-CARBIDE-PORTAL-PASSWORD-OR-TOKEN"

# -----------------------------------------------------------------------------
# Rancher Manager Configuration
# -----------------------------------------------------------------------------
rancher_version      = "2.14.3"
cert_manager_version = "1.21.1"

# RKE2 version (applies to all modules: rancher-manager, observability, security)
# Leave commented to use latest stable RKE2 release
# rke2_version = "v1.30.0+rke2r1"
# To find available RKE2 versions: https://github.com/rancher/rke2/releases
#
# NOTE: rancher_version, cert_manager_version, and rke2_version/latest-stable-
# RKE2 are all coupled - both the Rancher Helm chart and cert-manager pin a
# supported Kubernetes version window (rancher-2.14.3 requires kubeVersion <
# 1.36.0-0; cert-manager 1.21.x supports 1.33-1.36). If a future "latest
# stable" RKE2 release crosses either ceiling, bump both versions together -
# check https://releases.rancher.com/server-charts/stable/index.yaml
# (kubeVersion field) and https://cert-manager.io/docs/releases/

# Leave empty to install the public rancher-stable Helm chart (images sourced via
# registries.yaml). Set once a Carbide-hosted Rancher OCI chart reference is confirmed.
rgs_carbide_rancher_chart = ""

# -----------------------------------------------------------------------------
# RGS Observability Configuration
# -----------------------------------------------------------------------------
rgs_observability_license        = "YOUR_RGS_OBSERVABILITY_LICENSE_KEY"
rgs_observability_base_url       = "https://observability.rgs-demo-aws.kubernerdes.com"
rgs_rancher_url                  = "https://rancher.rgs-demo-aws.kubernerdes.com"
rgs_observability_admin_password = "" # Leave empty to auto-generate

# -----------------------------------------------------------------------------
# Optional: AMI Override (all modules)
# -----------------------------------------------------------------------------
# Leave empty to use the latest SL-Micro AMI (suse-sle-micro-6-*-byos, owner 013907871322)
ami_id = ""
