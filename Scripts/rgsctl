#!/bin/bash
#
# Quick Start Script for RGS Demo AWS Infrastructure
#
# Automates deployment/teardown of the RGS demo environment in AWS using
# OpenTofu modules. Adapted from suse-demo-aws's democtl.
#

# Color codes for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Project deployment order (CRITICAL: shared-services must be first).
# OpenTofu's job stops at "Rancher Manager is running" - everything
# downstream (Observability's cluster, the user-apps/Security cluster, EKS)
# is created FROM Rancher itself via its node/EKS drivers, using the Cloud
# Credential rancher-cloud-credential outputs. observability/ and security/
# are docs-only now (no .tf files) - see each module's README.md.
readonly PROJECTS=(shared-services rancher-manager rancher-cloud-credential)

# Modules with a running Kubernetes cluster reachable via the ssh_command
# output.
readonly K8S_PROJECTS=(rancher-manager)

#######################################
# Print colored message
# Arguments:
#   $1 - Color code
#   $2 - Message
#######################################
print_msg() {
    echo -e "${1}${2}${NC}"
}

#######################################
# Print section header
# Arguments:
#   $1 - Header text
#######################################
print_header() {
    echo
    print_msg "${BLUE}" "========================================"
    print_msg "${BLUE}" "$1"
    print_msg "${BLUE}" "========================================"
}

#######################################
# Check if OpenTofu is installed and working
#######################################
check_tofu() {
    if ! command -v tofu &> /dev/null; then
        print_msg "${RED}" "ERROR: OpenTofu is not installed or not in PATH"
        echo
        print_msg "${YELLOW}" "OpenTofu is required to run this script."
        echo
        print_msg "${BLUE}" "Installation instructions for macOS:"
        echo "  brew install opentofu"
        echo
        print_msg "${BLUE}" "For other platforms, visit: https://opentofu.org/docs/intro/install/"
        echo
        exit 1
    fi

    if ! tofu version &> /dev/null; then
        print_msg "${RED}" "ERROR: OpenTofu is installed but not working correctly"
        exit 1
    fi

    local tofu_version
    tofu_version=$(tofu version | head -n 1)
    print_msg "${GREEN}" "OpenTofu found: ${tofu_version}"
}

#######################################
# Verify we're at the repo root (parent of Scripts/)
#######################################
goto_repo_root() {
    cd "$(dirname "$0")/.." || exit 1

    if [ ! -d "shared-services" ]; then
        print_msg "${RED}" "ERROR: Cannot find project directories"
        print_msg "${YELLOW}" "Current directory: $(pwd)"
        exit 1
    fi

    if [ ! -f "terraform.tfvars" ]; then
        print_msg "${RED}" "ERROR: terraform.tfvars not found in repo root"
        print_msg "${YELLOW}" "Copy terraform.tfvars.example to terraform.tfvars and fill in real values first"
        exit 1
    fi
}

#######################################
# Read a single value out of terraform.tfvars (repo root, cwd must already
# be there - see goto_repo_root). Handles simple `key = "value"` and
# `key = true` style lines; not a full HCL parser.
# Arguments:
#   $1 - variable name
#######################################
get_tfvar() {
    local key="$1"
    local line
    line=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" terraform.tfvars | head -n 1)
    line="${line#*=}"
    line="${line%%#*}"
    line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    line="${line%\"}"
    line="${line#\"}"
    echo "$line"
}

#######################################
# Preflight: verify the AWS credentials in use can read the public Route53
# hosted zone configured in terraform.tfvars. Read access is treated as a
# reasonable proxy for write access (the zone being visible at all under
# these credentials implies permission to modify it) - this is a fast, safe
# check, not a full IAM-policy simulation.
#######################################
check_route53_access() {
    print_header "Checking Route53 Hosted Zone Access"

    local create_record
    create_record=$(get_tfvar create_route53_record)
    if [ "$create_record" != "true" ]; then
        print_msg "${YELLOW}" "create_route53_record is not true - skipping Route53 access check"
        return 0
    fi

    if ! command -v aws &> /dev/null; then
        print_msg "${RED}" "ERROR: AWS CLI not found - cannot verify Route53 access"
        exit 1
    fi

    local root_domain subdomain zone_id fqdn
    root_domain=$(get_tfvar root_domain)
    subdomain=$(get_tfvar subdomain)
    zone_id=$(get_tfvar route53_zone_id)
    fqdn="${subdomain}.${root_domain}"

    local private_zone result

    if [ -n "$zone_id" ]; then
        zone_id="${zone_id#/hostedzone/}"
        print_msg "${BLUE}" "Checking configured zone ID: ${zone_id}"
        if ! result=$(aws route53 get-hosted-zone --id "$zone_id" \
            --query 'HostedZone.Config.PrivateZone' --output text 2>&1); then
            print_msg "${RED}" "ERROR: Cannot access Route53 hosted zone ${zone_id}"
            print_msg "${YELLOW}" "${result}"
            print_msg "${YELLOW}" "Check that your AWS credentials have route53:GetHostedZone on this zone"
            exit 1
        fi
        private_zone="$result"
    else
        print_msg "${BLUE}" "Looking up public hosted zone for: ${fqdn}"
        if ! result=$(aws route53 list-hosted-zones-by-name --dns-name "${fqdn}" \
            --query "HostedZones[?Name=='${fqdn}.'].Config.PrivateZone | [0]" --output text 2>&1); then
            print_msg "${RED}" "ERROR: Failed to query Route53 (check AWS credentials/permissions)"
            print_msg "${YELLOW}" "${result}"
            exit 1
        fi
        if [ "$result" = "None" ] || [ -z "$result" ]; then
            print_msg "${RED}" "ERROR: No hosted zone found for ${fqdn} in this AWS account"
            print_msg "${YELLOW}" "Set route53_zone_id explicitly in terraform.tfvars, or create the zone first"
            exit 1
        fi
        private_zone="$result"
    fi

    if [ "$private_zone" = "True" ]; then
        print_msg "${RED}" "ERROR: Hosted zone for ${fqdn} is a PRIVATE zone - a public zone is required"
        exit 1
    fi

    print_msg "${GREEN}" "Route53 public hosted zone for ${fqdn} is accessible"
}

#######################################
# Collect every resource ID (and public_ip, where present) currently
# tracked across all modules' local tofu state. Used by `orphans` to tell
# "still managed" apart from "drifted/orphaned in AWS but not in state" -
# e.g. the aws_key_pair left behind by an interrupted destroy on 2026-08-05.
# Prints one value per line; safe to call even for modules never applied.
#######################################
collect_known_ids() {
    # This repo's own Quick Start archives an existing checkout (mv to
    # "<repo>-YYYY-MM-DD-NN") before cloning fresh rather than destroying it
    # first - so a freshly cloned working copy legitimately has empty state
    # while the *real* tracked state for still-live resources sits in a
    # sibling archived directory. Confirmed live 2026-08-05: after several
    # archive/re-clone cycles, all 5 modules' real state was found only in
    # one sibling archive dir, while the current checkout's state was an
    # empty 720-byte skeleton - scanning only "." would have misreported
    # every live resource as orphaned. Scan every sibling "<repo>*" dir too.
    local repo_base search_dirs=(".") d
    repo_base=$(basename "$(pwd)")
    for d in ../"${repo_base}"*; do
        [ -d "$d" ] || continue
        [ "$(cd "$d" && pwd)" = "$(pwd)" ] && continue
        search_dirs+=("$d")
    done
    print_msg "${BLUE}" "  Scanning for state in: ${search_dirs[*]}" >&2

    local base_dir module
    for base_dir in "${search_dirs[@]}"; do
        for module in "${PROJECTS[@]}"; do
            [ -f "${base_dir}/${module}/terraform.tfstate" ] || continue
            (cd "${base_dir}/${module}" && tofu show -json 2>/dev/null) | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
def walk(mod):
    for r in mod.get('resources', []):
        v = r.get('values', {}) or {}
        for key in ('id', 'public_ip'):
            val = v.get(key)
            if val:
                print(val)
    for child in mod.get('child_modules', []):
        walk(child)
walk(d.get('values', {}).get('root_module', {}))
" 2>/dev/null
        done
    done
}

#######################################
# IAM helpers: roles/instance profiles can't be deleted while still
# attached to policies or each other, so unwind those relationships first.
#######################################
rgsctl_delete_iam_role() {
    local role_name="$1" arn policy_name profile_name
    for arn in $(aws iam list-attached-role-policies --role-name "$role_name" \
        --query "AttachedPolicies[].PolicyArn" --output text 2>/dev/null); do
        aws iam detach-role-policy --role-name "$role_name" --policy-arn "$arn"
    done
    for policy_name in $(aws iam list-role-policies --role-name "$role_name" \
        --query "PolicyNames[]" --output text 2>/dev/null); do
        aws iam delete-role-policy --role-name "$role_name" --policy-name "$policy_name"
    done
    for profile_name in $(aws iam list-instance-profiles-for-role --role-name "$role_name" \
        --query "InstanceProfiles[].InstanceProfileName" --output text 2>/dev/null); do
        aws iam remove-role-from-instance-profile --role-name "$role_name" --instance-profile-name "$profile_name"
    done
    aws iam delete-role --role-name "$role_name"
}

rgsctl_delete_iam_instance_profile() {
    local profile_name="$1" role_name
    for role_name in $(aws iam get-instance-profile --instance-profile-name "$profile_name" \
        --query "InstanceProfile.Roles[].RoleName" --output text 2>/dev/null); do
        aws iam remove-role-from-instance-profile --instance-profile-name "$profile_name" --role-name "$role_name"
    done
    aws iam delete-instance-profile --instance-profile-name "$profile_name"
}

#######################################
# Route53 helper: DELETE requires the exact existing record set, so fetch
# it first and issue the change batch via a temp file (avoids shell-quoting
# a JSON blob).
#######################################
rgsctl_delete_route53_record() {
    local zone_id="$1" fqdn="$2"
    local rec_file batch_file
    rec_file=$(mktemp)
    batch_file=$(mktemp)

    aws route53 list-resource-record-sets --hosted-zone-id "$zone_id" \
        --query "ResourceRecordSets[?Name=='${fqdn}.' && Type=='A'] | [0]" --output json > "$rec_file" 2>/dev/null

    if ! python3 -c "import json,sys; sys.exit(0 if json.load(open('$rec_file')) else 1)" 2>/dev/null; then
        print_msg "${YELLOW}" "  Record ${fqdn} already gone"
        rm -f "$rec_file" "$batch_file"
        return 0
    fi

    python3 -c "
import json
rec = json.load(open('$rec_file'))
print(json.dumps({'Changes': [{'Action': 'DELETE', 'ResourceRecordSet': rec}]}))
" > "$batch_file"

    aws route53 change-resource-record-sets --hosted-zone-id "$zone_id" --change-batch "file://${batch_file}"
    rm -f "$rec_file" "$batch_file"
}

#######################################
# Orphans: find (and optionally delete) AWS resources tagged/named for this
# environment that aren't tracked in any module's current tofu state - the
# kind of drift that caused the "key pair already exists" error on
# 2026-08-05 (an interrupted destroy left the key pair behind in AWS while
# local state moved on without it).
#
# List-only by default; pass --delete to actually remove what's found (asks
# for confirmation first, same as `destroy`).
#
# Covers: EC2 instances, EC2 key pairs, Elastic IPs, security groups, IAM
# roles/instance profiles/customer-managed policies (all name-prefixed
# "${environment}-"), and Route53 A records for our three known hostnames
# (Route53 record sets aren't taggable, so these are flagged by checking
# whether their target IP matches any currently-tracked EIP/instance, not
# by ID).
#######################################
orphans() {
    local delete_mode="false"
    [ "${1:-}" = "--delete" ] && delete_mode="true"

    check_tofu
    goto_repo_root

    if ! command -v python3 &> /dev/null; then
        print_msg "${RED}" "ERROR: python3 is required to parse tofu/AWS JSON output"
        exit 1
    fi

    print_header "Scanning for Orphaned AWS Resources"

    local environment region
    environment=$(get_tfvar environment)
    region=$(get_tfvar aws_region)
    [ -z "$environment" ] && environment="rgs-demo-aws"
    [ -z "$region" ] && region="us-east-2"
    print_msg "${BLUE}" "Environment tag/prefix: ${environment}   Region: ${region}"

    print_msg "${BLUE}" "Collecting resource IDs currently tracked in tofu state..."
    local known_ids
    known_ids=$(collect_known_ids)
    print_msg "${GREEN}" "Found $(echo "$known_ids" | grep -c . || true) known resource IDs/IPs across applied modules"

    is_known() {
        [ -n "$1" ] && echo "$known_ids" | grep -qxF "$1"
    }

    local -a o_type=() o_id=() o_label=()
    add_orphan() { o_type+=("$1"); o_id+=("$2"); o_label+=("$3"); }

    print_msg "${BLUE}" "Checking EC2 instances..."
    while IFS=$'\t' read -r id name; do
        [ -z "$id" ] && continue
        is_known "$id" || add_orphan "instance" "$id" "EC2 instance ${id} (${name})"
    done < <(aws ec2 describe-instances --region "${region}" \
        --filters "Name=tag:Environment,Values=${environment}" "Name=instance-state-name,Values=pending,running,stopping,stopped" \
        --query "Reservations[].Instances[].[InstanceId, Tags[?Key=='Name']|[0].Value]" --output text 2>/dev/null)

    print_msg "${BLUE}" "Checking EC2 key pairs..."
    while IFS=$'\t' read -r name; do
        [ -z "$name" ] && continue
        is_known "$name" || add_orphan "keypair" "$name" "Key pair ${name}"
    done < <(aws ec2 describe-key-pairs --region "${region}" \
        --filters "Name=tag:Environment,Values=${environment}" \
        --query "KeyPairs[].KeyName" --output text 2>/dev/null | tr '\t' '\n')

    print_msg "${BLUE}" "Checking Elastic IPs..."
    while IFS=$'\t' read -r alloc_id name; do
        [ -z "$alloc_id" ] && continue
        is_known "$alloc_id" || add_orphan "eip" "$alloc_id" "Elastic IP ${alloc_id} (${name})"
    done < <(aws ec2 describe-addresses --region "${region}" \
        --filters "Name=tag:Environment,Values=${environment}" \
        --query "Addresses[].[AllocationId, Tags[?Key=='Name']|[0].Value]" --output text 2>/dev/null)

    print_msg "${BLUE}" "Checking security groups..."
    while IFS=$'\t' read -r sg_id name; do
        [ -z "$sg_id" ] && continue
        is_known "$sg_id" || add_orphan "sg" "$sg_id" "Security group ${sg_id} (${name})"
    done < <(aws ec2 describe-security-groups --region "${region}" \
        --filters "Name=tag:Environment,Values=${environment}" \
        --query "SecurityGroups[].[GroupId, GroupName]" --output text 2>/dev/null)

    print_msg "${BLUE}" "Checking IAM roles (prefix ${environment}-)..."
    while IFS=$'\t' read -r role_name; do
        [ -z "$role_name" ] && continue
        case "$role_name" in
            "${environment}-"*)
                is_known "$role_name" || add_orphan "iam-role" "$role_name" "IAM role ${role_name}"
                ;;
        esac
    done < <(aws iam list-roles --query "Roles[].RoleName" --output text 2>/dev/null | tr '\t' '\n')

    print_msg "${BLUE}" "Checking IAM instance profiles (prefix ${environment}-)..."
    while IFS=$'\t' read -r prof_name; do
        [ -z "$prof_name" ] && continue
        case "$prof_name" in
            "${environment}-"*)
                is_known "$prof_name" || add_orphan "iam-profile" "$prof_name" "IAM instance profile ${prof_name}"
                ;;
        esac
    done < <(aws iam list-instance-profiles --query "InstanceProfiles[].InstanceProfileName" --output text 2>/dev/null | tr '\t' '\n')

    print_msg "${BLUE}" "Checking IAM customer-managed policies (prefix ${environment}-)..."
    while IFS=$'\t' read -r policy_arn policy_name; do
        [ -z "$policy_arn" ] && continue
        case "$policy_name" in
            "${environment}-"*)
                is_known "$policy_arn" || add_orphan "iam-policy" "$policy_arn" "IAM policy ${policy_name}"
                ;;
        esac
    done < <(aws iam list-policies --scope Local --query "Policies[].[Arn, PolicyName]" --output text 2>/dev/null)

    print_msg "${BLUE}" "Checking Route53 A records..."
    local root_domain subdomain zone_id
    root_domain=$(get_tfvar root_domain)
    subdomain=$(get_tfvar subdomain)
    zone_id=$(get_tfvar route53_zone_id)
    if [ -z "$zone_id" ] && [ -n "$root_domain" ] && [ -n "$subdomain" ]; then
        zone_id=$(aws route53 list-hosted-zones-by-name --dns-name "${subdomain}.${root_domain}" \
            --query "HostedZones[?Name=='${subdomain}.${root_domain}.'].Id | [0]" --output text 2>/dev/null)
    fi
    zone_id="${zone_id#/hostedzone/}"

    if [ -n "$zone_id" ] && [ "$zone_id" != "None" ] && [ -n "$root_domain" ] && [ -n "$subdomain" ]; then
        local hostname_var hn fqdn record_ip
        for hostname_var in hostname_rancher hostname_observability hostname_userapps; do
            hn=$(get_tfvar "$hostname_var")
            [ -z "$hn" ] && continue
            fqdn="${hn}.${subdomain}.${root_domain}"
            record_ip=$(aws route53 list-resource-record-sets --hosted-zone-id "$zone_id" \
                --query "ResourceRecordSets[?Name=='${fqdn}.' && Type=='A'].ResourceRecords[0].Value | [0]" \
                --output text 2>/dev/null)
            if [ -n "$record_ip" ] && [ "$record_ip" != "None" ] && ! is_known "$record_ip"; then
                add_orphan "route53" "${zone_id}|${fqdn}" "Route53 A record ${fqdn} -> ${record_ip} (not a currently tracked IP)"
            fi
        done
    else
        print_msg "${YELLOW}" "  Skipping Route53 check (could not resolve zone_id/root_domain/subdomain)"
    fi

    print_header "Results"

    if [ "${#o_type[@]}" -eq 0 ]; then
        print_msg "${GREEN}" "No orphaned resources found."
        return 0
    fi

    local i
    for i in "${!o_type[@]}"; do
        print_msg "${YELLOW}" "  - ${o_label[$i]}"
    done

    if [ "$delete_mode" != "true" ]; then
        echo
        print_msg "${BLUE}" "Re-run with --delete to remove these."
        return 0
    fi

    echo
    print_msg "${RED}" "WARNING: about to delete the ${#o_type[@]} resource(s) listed above."
    read -r -p "Are you sure you want to continue? (yes/no): " confirm
    if [ "${confirm}" != "yes" ]; then
        print_msg "${YELLOW}" "Cancelled - nothing deleted"
        return 0
    fi

    local delete_status
    for i in "${!o_type[@]}"; do
        print_msg "${YELLOW}" "Deleting: ${o_label[$i]}"
        delete_status=0
        case "${o_type[$i]}" in
            instance)     aws ec2 terminate-instances --region "$region" --instance-ids "${o_id[$i]}" > /dev/null || delete_status=$? ;;
            keypair)      aws ec2 delete-key-pair --region "$region" --key-name "${o_id[$i]}" || delete_status=$? ;;
            eip)          aws ec2 release-address --region "$region" --allocation-id "${o_id[$i]}" || delete_status=$? ;;
            sg)           aws ec2 delete-security-group --region "$region" --group-id "${o_id[$i]}" || delete_status=$? ;;
            iam-role)     rgsctl_delete_iam_role "${o_id[$i]}" || delete_status=$? ;;
            iam-profile)  rgsctl_delete_iam_instance_profile "${o_id[$i]}" || delete_status=$? ;;
            iam-policy)   aws iam delete-policy --policy-arn "${o_id[$i]}" || delete_status=$? ;;
            route53)      rgsctl_delete_route53_record "${o_id[$i]%%|*}" "${o_id[$i]#*|}" || delete_status=$? ;;
        esac
        if [ "$delete_status" -eq 0 ]; then
            print_msg "${GREEN}" "  Deleted"
        else
            print_msg "${RED}" "  Failed - check manually"
        fi
    done

    print_header "Cleanup Complete!"
}

#######################################
# Build: Deploy all infrastructure
#######################################
build() {
    print_header "Building RGS Demo AWS Deployment"

    check_tofu
    goto_repo_root
    check_route53_access

    print_header "Deploying Infrastructure Modules"

    for PROJECT in "${PROJECTS[@]}"; do
        print_msg "${GREEN}" "Deploying: ${PROJECT}"

        cd "${PROJECT}" || exit 1

        tofu init || { print_msg "${RED}" "Failed to initialize ${PROJECT}"; exit 1; }
        tofu plan -var-file=../terraform.tfvars || { print_msg "${RED}" "Failed to plan ${PROJECT}"; exit 1; }
        echo "yes" | tofu apply -var-file=../terraform.tfvars || { print_msg "${RED}" "Failed to apply ${PROJECT}"; exit 1; }

        cd - > /dev/null || exit 1
        print_msg "${GREEN}" "Successfully deployed: ${PROJECT}"
    done

    print_header "Deployment Outputs"
    for PROJECT in "${PROJECTS[@]}"; do
        echo
        print_msg "${BLUE}" "Output from: ${PROJECT}"
        print_msg "${BLUE}" "----------------------------------------"
        cd "${PROJECT}" || exit 1
        tofu output
        cd - > /dev/null || exit 1
    done

    show_urls

    print_header "Deployment Complete!"
    print_msg "${GREEN}" "Rancher Manager is up. Everything downstream is now created FROM Rancher itself:"
    print_msg "${YELLOW}" "Next steps:"
    echo "  1. In Rancher: Cluster Management -> Cloud Credentials -> Create -> Amazon,"
    echo "     using rancher-cloud-credential's access_key_id/secret_access_key outputs"
    echo "  2. Create the Observability and user-apps clusters via the EC2 node driver,"
    echo "     and the EKS cluster via the EKS driver - see each module's README.md"
    echo "  3. Once each is Active: observability/install-rgs-observability.sh for RGS"
    echo "     Observability; RGS Security's chart source is still TBD (see security/README.md)"
}

#######################################
# Destroy: Destroy all infrastructure
# CRITICAL: Destroys in REVERSE order to respect dependencies
#######################################
destroy() {
    print_header "Destroying RGS Demo AWS Infrastructure"

    check_tofu
    goto_repo_root

    print_msg "${RED}" "WARNING: This will destroy ALL infrastructure!"
    read -r -p "Are you sure you want to continue? (yes/no): " confirm
    if [ "${confirm}" != "yes" ]; then
        print_msg "${YELLOW}" "Destruction cancelled"
        exit 0
    fi

    for (( idx=${#PROJECTS[@]}-1 ; idx>=0 ; idx-- )); do
        PROJECT="${PROJECTS[idx]}"
        print_msg "${YELLOW}" "Destroying: ${PROJECT}"

        cd "${PROJECT}" || exit 1

        echo "yes" | tofu destroy -var-file=../terraform.tfvars || {
            print_msg "${RED}" "Failed to destroy ${PROJECT}"
            print_msg "${YELLOW}" "You may need to manually destroy remaining resources"
            exit 1
        }

        cd - > /dev/null || exit 1
        print_msg "${GREEN}" "Successfully destroyed: ${PROJECT}"
    done

    print_header "Destruction Complete!"
    print_msg "${GREEN}" "All infrastructure has been destroyed."
    print_msg "${YELLOW}" "Note: downstream clusters created via Rancher's node/EKS drivers (Observability,"
    print_msg "${YELLOW}" "user-apps, EKS) aren't tracked here - delete those from Rancher first, since this"
    print_msg "${YELLOW}" "just destroyed the Cloud Credential (rancher-cloud-credential) they used."
}

#######################################
# Output: Display OpenTofu outputs from all projects
#######################################
show_output() {
    print_header "OpenTofu Outputs from All Projects"

    check_tofu
    goto_repo_root

    for PROJECT in "${PROJECTS[@]}"; do
        echo
        print_msg "${BLUE}" "Output from: ${PROJECT}"
        print_msg "${BLUE}" "----------------------------------------"

        if [ ! -d "${PROJECT}" ]; then
            print_msg "${YELLOW}" "WARNING: Project directory ${PROJECT} not found"
            continue
        fi

        cd "${PROJECT}" || exit 1
        tofu init -backend=true > /dev/null 2>&1 || print_msg "${YELLOW}" "WARNING: Failed to initialize ${PROJECT}"
        tofu output
        cd - > /dev/null || exit 1
    done

    print_header "Output Display Complete!"
}

#######################################
# URLs: print each product's app URL in one place, rather than making you
# dig through the full `tofu output` dump per module.
#######################################
show_urls() {
    print_header "Product URLs"

    check_tofu
    goto_repo_root

    local rancher_url
    if [ -d "rancher-manager" ]; then
        rancher_url=$(cd rancher-manager && tofu output -raw rancher_url 2>/dev/null)
    fi

    if [ -n "$rancher_url" ]; then
        print_msg "${GREEN}" "Rancher: ${rancher_url}"
    else
        print_msg "${YELLOW}" "Rancher: (not deployed yet)"
    fi

    print_msg "${YELLOW}" "Observability/Security/EKS clusters are created and managed from Rancher"
    print_msg "${YELLOW}" "itself now (no tofu output for them) - check the Rancher UI for their URLs"
    print_msg "${YELLOW}" "once Active. See observability/README.md and security/README.md."
}

#######################################
# Get kubeconfig: retrieve kubeconfig from the rancher-manager node
#######################################
getkube() {
    print_header "Retrieving Kubeconfig Files"

    check_tofu
    goto_repo_root

    mkdir -p .kube

    for PROJECT in "${K8S_PROJECTS[@]}"; do
        echo
        print_msg "${BLUE}" "Retrieving kubeconfig from: ${PROJECT}"
        print_msg "${BLUE}" "----------------------------------------"

        if [ ! -d "${PROJECT}" ]; then
            print_msg "${YELLOW}" "WARNING: Project directory ${PROJECT} not found"
            continue
        fi

        cd "${PROJECT}" || exit 1

        local ssh_cmd
        ssh_cmd=$(tofu output -raw ssh_command 2>/dev/null)

        if [ -z "$ssh_cmd" ] || [ "$ssh_cmd" = "Use AWS Systems Manager Session Manager to connect" ]; then
            print_msg "${YELLOW}" "WARNING: No SSH access configured for ${PROJECT}"
            cd - > /dev/null || exit 1
            continue
        fi

        local ssh_key
        local ssh_host
        ssh_key=$(echo "$ssh_cmd" | grep -o '\-i [^ ]*' | cut -d' ' -f2)
        ssh_host=$(echo "$ssh_cmd" | grep -o 'ec2-user@[^ ]*' | cut -d'@' -f2)
        ssh_key="${ssh_key/#\~/$HOME}"

        local output_file="../.kube/${PROJECT}.kubeconfig"
        print_msg "${BLUE}" "Copying kubeconfig to: .kube/${PROJECT}.kubeconfig"

        # RKE2's kubeconfig lives at /etc/rancher/rke2/rke2.yaml (also copied
        # to ~ec2-user/.kube/config by user-data.sh)
        if scp -i "$ssh_key" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            "ec2-user@${ssh_host}:/home/ec2-user/.kube/config" "$output_file" 2>/dev/null; then
            print_msg "${GREEN}" "Retrieved kubeconfig for ${PROJECT}"

            local hostname
            hostname=$(tofu output -raw rancher_hostname 2>/dev/null)
            local server_address="${ssh_host}"
            [ -n "$hostname" ] && [ "$hostname" != "null" ] && server_address="$hostname"

            local temp_file="${output_file}.tmp"
            sed "s|127\.0\.0\.1:6443|${server_address}:6443|g; s|localhost:6443|${server_address}:6443|g" "$output_file" > "$temp_file" \
                && mv "$temp_file" "$output_file"
            print_msg "${GREEN}" "Updated server address to: ${server_address}:6443"
        else
            print_msg "${RED}" "Failed to retrieve kubeconfig for ${PROJECT}"
        fi

        cd - > /dev/null || exit 1
    done

    print_header "Kubeconfig Retrieval Complete!"
    print_msg "${YELLOW}" "For Observability/Security/EKS clusters, grab kubeconfig from the Rancher UI -"
    print_msg "${YELLOW}" "they're created and managed by Rancher directly, not tracked here."
}

#######################################
# Display help information
#######################################
show_help() {
    cat << EOF

RGS Demo AWS - Quick Start Script

USAGE:
    $(basename "$0") [OPTION]

OPTIONS:
    build       Deploy AWS-side infrastructure in order: shared-services,
                rancher-manager, rancher-cloud-credential. Everything else
                (Observability, user-apps/Security, EKS) is then created
                FROM Rancher itself - see "MANUAL STEPS" below.

    destroy     Destroy all AWS-side infrastructure in reverse order
                Prompts for confirmation before proceeding

    output      Display OpenTofu outputs from all deployed modules

    urls        Print Rancher's URL (also shown at the end of build)

    getkube     Retrieve kubeconfig from the rancher-manager node

    checkdns    Verify your AWS credentials can access the Route53 public
                hosted zone configured in terraform.tfvars (runs
                automatically as part of build)

    orphans [--delete]
                Scan for AWS resources tagged/named for this environment
                that aren't tracked in any module's current tofu state -
                e.g. a key pair left behind by an interrupted destroy. Lists
                by default; pass --delete to actually remove what's found
                (asks for confirmation first).

    help        Display this help message

DEPLOYMENT ORDER:
    1. shared-services          (VPC, networking, security groups)
    2. rancher-manager          (single-node RKE2 + Rancher Manager)
    3. rancher-cloud-credential (IAM user+key for Rancher's node/EKS drivers)

MANUAL STEPS (from the Rancher UI, once build finishes):
    1. Cluster Management -> Cloud Credentials -> Create -> Amazon, using
       rancher-cloud-credential's access_key_id/secret_access_key outputs
    2. Create the Observability and user-apps clusters via the EC2 node
       driver, and the EKS cluster via the EKS driver - see
       rancher-cloud-credential/README.md, observability/README.md, and
       security/README.md
    3. Once Active: observability/install-rgs-observability.sh installs RGS
       Observability. RGS Security's chart source is still unconfirmed.

PREREQUISITES:
    - AWS CLI configured with valid credentials
    - OpenTofu >= 1.5.0 installed
    - python3 (for 'orphans' - parses AWS/tofu JSON output)
    - terraform.tfvars in the repo root (copy from terraform.tfvars.example)

EXAMPLES:
    $(basename "$0") build
    $(basename "$0") output
    $(basename "$0") urls
    $(basename "$0") getkube
    $(basename "$0") orphans
    $(basename "$0") orphans --delete
    $(basename "$0") destroy

For more information, see: https://github.com/jradtke-rgs/rgs-demo-aws

EOF
}

#######################################
# Main execution
#######################################
main() {
    case "${1:-}" in
        build)
            build
            ;;
        destroy)
            destroy
            ;;
        output)
            show_output
            ;;
        getkube)
            getkube
            ;;
        checkdns)
            goto_repo_root
            check_route53_access
            ;;
        orphans)
            orphans "$2"
            ;;
        urls)
            show_urls
            ;;
        help|--help|-h)
            show_help
            ;;
        "")
            print_msg "${RED}" "ERROR: No option specified"
            echo
            show_help
            exit 1
            ;;
        *)
            print_msg "${RED}" "ERROR: Invalid option: $1"
            echo
            show_help
            exit 1
            ;;
    esac
}

main "$@"
